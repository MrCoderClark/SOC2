generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ORGANIZATION & USERS
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  controls    Control[]
  policies    Policy[]
  evidence    Evidence[]
  audits      Audit[]
  integrations Integration[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  role           UserRole @default(MEMBER)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedControls Control[]     @relation("AssignedControls")
  uploadedEvidence Evidence[]
  auditComments  AuditComment[]

  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  AUDITOR
}

// ============================================
// SOC 2 FRAMEWORK
// ============================================

model Control {
  id             String        @id @default(cuid())
  code           String        // e.g., "CC1.1"
  name           String
  description    String
  category       ControlCategory
  status         ControlStatus @default(NOT_STARTED)
  organizationId String
  assigneeId     String?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("AssignedControls", fields: [assigneeId], references: [id])
  evidence     Evidence[]
  policies     Policy[]     @relation("ControlPolicies")

  @@unique([organizationId, code])
  @@map("controls")
}

enum ControlCategory {
  SECURITY
  AVAILABILITY
  PROCESSING_INTEGRITY
  CONFIDENTIALITY
  PRIVACY
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  VERIFIED
  NOT_APPLICABLE
}

// ============================================
// POLICIES & EVIDENCE
// ============================================

model Policy {
  id             String       @id @default(cuid())
  title          String
  content        String       @db.Text
  version        Int          @default(1)
  status         PolicyStatus @default(DRAFT)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls     Control[]    @relation("ControlPolicies")

  @@map("policies")
}

enum PolicyStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

model Evidence {
  id             String       @id @default(cuid())
  title          String
  description    String?
  fileUrl        String?
  fileType       String?
  status         EvidenceStatus @default(PENDING)
  controlId      String
  organizationId String
  uploadedById   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  control      Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@map("evidence")
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ============================================
// AUDITS
// ============================================

model Audit {
  id             String      @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime?
  status         AuditStatus @default(PLANNING)
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments     AuditComment[]

  @@map("audits")
}

enum AuditStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

model AuditComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  auditId   String
  authorId  String
  createdAt DateTime @default(now())

  audit  Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@map("audit_comments")
}

// ============================================
// INTEGRATIONS
// ============================================

model Integration {
  id             String            @id @default(cuid())
  type           IntegrationType
  name           String
  config         Json?
  status         IntegrationStatus @default(INACTIVE)
  organizationId String
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@map("integrations")
}

enum IntegrationType {
  AWS
  AZURE
  GCP
  GITHUB
  JIRA
  SLACK
  OKTA
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}
